# Java
*.class
out/
bin/

# Python
__pycache__/
*.pyc
.venv/

# macOS
.DS_Store

# IDE
.idea/
.vscode/
*.iml

# Dữ liệu lớn (> 10^6 phần tử): không đưa lên git,
# tái tạo bằng generator + seed + SHA-256 trong data/manifest.csv
data/*_10000000.bin
data/*_2097152.bin
data/*_4194304.bin
data/*_8388608.bin

# Số liệu bị loại vì hai đợt đo chạy chồng nhau: chỉ giữ trên máy,
# riêng file ghi chú lý do thì đưa lên git
results/bi-chay-chong/*
!results/bi-chay-chong/GHI-CHU.md
